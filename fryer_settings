type: custom:bubble-card
card_type: pop-up
hash: '#fryer_settings'
margin_top_mobile: calc(100vh - 900px)
margin_top_desktop: calc(100vh - 1190px)
show_header: false
close_by_clicking_outside: false
button_type: name
styles: |
  #root {
    border: 1px solid rgba(var(--rgb-primary-text-color),0.1);
    
    }
sub_button:
  main: []
  bottom: []
cards:
  - type: custom:mushroom-chips-card
    chips:
      - type: template
        content: Xiaomi Air Fryer
        double_tap_action:
          action: none
        tap_action:
          action: none
        hold_action:
          action: none
        icon: ''
      - type: spacer
      - type: back
        card_mod:
          style:
            .: |
              {% set hover = 'true' %}
              {% set stating = 'false' %}
              {% include 'chip_settings_style.jinja' %}
    card_mod:
      style:
        mushroom-back-chip:nth-child(3)$: |
          ha-state-icon {
            --card-mod-icon: mdi:close;
          }
        .: |
          {% include 'pop_up_title.jinja' %}
    grid_options:
      columns: 12
      rows: auto
  - type: custom:bubble-card
    card_type: separator
    name: Температура готовки
    icon: mdi:thermometer
    styles: |
      .bubble-line {
        background: var(--primary-text-color);
        opacity: 0.1;
      }
    sub_button: []
    grid_options:
      columns: 12
  - type: custom:mushroom-number-card
    entity: number.xiaomi_ru_917438569_maf65_target_temperature_p_2_4
    primary_info: none
    secondary_info: none
    icon_type: none
    tap_action:
      action: none
    hold_action:
      action: none
    double_tap_action:
      action: none
    display_mode: buttons
    card_mod:
      style:
        mushroom-media-player-volume-control$: |
          mushroom-slider {
            --main-color: #505050 !important;
            --bg-color: #50505055 !important;
            --control-height: 20px !important;

          }
        .: |
          ha-card {
            background: transparent !important;
            opacity: 100%;
            border-width: 0px;
            
              }
          ha-card:hover {
            opacity: 100%;
            }
    grid_options:
      columns: 12
      rows: auto
