type: custom:bubble-card
card_type: pop-up
hash: "#fryer_settings"
margin_top_mobile: calc(100vh - 900px)
margin_top_desktop: calc(100vh - 1190px)
show_header: false
close_by_clicking_outside: false
backdrop_blur: "5"
bg_blur: "100"
bg_opacity: "50"
button_type: name
styles: |
  #root {
    border: 1px solid rgba(var(--rgb-primary-text-color),0.1);
    background: rgba(255, 255, 255, 0.1);
    }
sub_button:
